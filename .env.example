# Copy to .env. The defaults below are for your own machine only.
# For a server, fill in every value and start with docker-compose.prod.yml (see README).
# Generate secrets with:  openssl rand -base64 48

DB_PASSWORD=creditsense
JWT_SECRET=replace-with-at-least-32-random-bytes-of-secret
ML_SERVICE_TOKEN=replace-with-a-random-service-token

# Demo accounts and about 50 sample applications (password Demo@1234). Use false for a real deployment.
SEED_DEMO_DATA=true

# Optuna trials when retraining (0 = reuse the champion's tuned hyperparameters)
ML_RETRAIN_TRIALS=0

# Production only (docker-compose.prod.yml)
# PUBLIC_ORIGIN=https://credit.example.in
# HTTP_PORT=80

# Sign in with Google (public deployments). With PASSWORD_LOGIN_ENABLED=false (the prod default) Google is the only way in.
# Create an OAuth "Web application" client at console.cloud.google.com and list your site under Authorized JavaScript origins.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# ADMIN_EMAILS=you@gmail.com
# OFFICER_EMAILS=officer1@gmail.com,officer2@gmail.com
# PASSWORD_LOGIN_ENABLED=false
